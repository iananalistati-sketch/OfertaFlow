# OfertaFlow — conexão com Supabase (este endereço público NÃO é uma credencial)
NEXT_PUBLIC_SUPABASE_URL=https://pbualjlqihfncjzuxnrt.supabase.co
# Supabase Dashboard > Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Apenas servidor. Preferir a nova Secret key do Supabase:
SUPABASE_SECRET_KEY=
# Compatibilidade temporária com projetos que usam a legacy service_role:
SUPABASE_SERVICE_ROLE_KEY=

# Nunca criar variáveis NEXT_PUBLIC_ para chaves secretas.
# Não colocar chaves reais no GitHub. Copie para .env.local (ignorado pelo Git).

# Opcional: execução automática da migração (não é a Supabase Secret key).
# Supabase > Connect > Connection string > Session pooler (porta 5432).
# Substitua o marcador de senha, usando URL-encoding para caracteres especiais.
OFERTAFLOW_DATABASE_URL=
# E-mail que será criado/autorizado como administrador inicial.
OFERTAFLOW_ADMIN_EMAIL=

# Shopee Affiliate Open API — credenciais liberadas pela Shopee (somente servidor).
# NÃO são as credenciais de login da Shopee e nunca usam NEXT_PUBLIC_.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

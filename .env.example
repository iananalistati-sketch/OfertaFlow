# OfertaFlow — conexão com Supabase (este endereço público NÃO é uma credencial)
NEXT_PUBLIC_SUPABASE_URL=https://pbualjlqihfncjzuxnrt.supabase.co
# Supabase Dashboard > Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Apenas servidor. Preferir a nova Secret key do Supabase:
SUPABASE_SECRET_KEY=
# Compatibilidade temporária com projetos que usam a legacy service_role:
SUPABASE_SERVICE_ROLE_KEY=

# Nunca criar variáveis NEXT_PUBLIC_ para chaves secretas.
# Não colocar chaves reais no GitHub. Copie para .env.local (ignorado pelo Git).
